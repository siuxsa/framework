# ══════════════════════════════════════════════════════════════
#  SIUXSA PRO — Environment Configuration Template
#  Copy this file to .env and fill in your values.
#  .env is blocked at the API level (always 403) and should
#  never be committed to version control.
# ══════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────
APP_PORT=3000
APP_HOST=0.0.0.0

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://0.0.0.0:3000

# ── Database ──────────────────────────────────────────────────
DB_PATH=siuxsa.db

# ── Security ──────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key

# ── AI Integration (optional) ─────────────────────────────────
GEMINI_API_KEY=

# ── Application URL ───────────────────────────────────────────
APP_URL=http://localhost:3000

# ── Debug ─────────────────────────────────────────────────────
# true = Uvicorn reload + verbose logging + API docs enabled
DEBUG=false
